# Esta carpeta admite subidas de imágenes desde el panel de administración.
# Por seguridad, nunca debe poder ejecutarse nada como PHP aquí, aunque
# alguien consiguiera subir un archivo con esa extensión.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php\d)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
